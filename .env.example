# Database Configuration (MySQL)
# For local development:
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
# For Cloud deployment (Render/Aiven/TiDB):
# DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=VERIFY_IDENTITY

# Spring Mail (SMTP - Gmail / Custom)
# Note: For Gmail, use a 16-character Google App Password (not your personal account password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# JWT Security Key
# Base64-encoded secret key or a 256-bit secure secret string
JWT_SECRET=your_jwt_secret_key_here

# Groq AI Assistant (Free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
